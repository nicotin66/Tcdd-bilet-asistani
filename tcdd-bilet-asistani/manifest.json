{
  "manifest_version": 3,
  "name": "TCDD Bilet Avcısı - Otomatik Koltuk Takipçisi",
  "version": "1.0.1",
  "description": "TCDD tren seferlerinde boş koltukları periyodik olarak otomatik tarar, boş yer açıldığında anında sesli ve masaüstü bildirimle koltuk seçimine yönlendirir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TCDD Bilet Avcısı"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.tcddtasimacilik.gov.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tcddtasimacilik.gov.tr/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.tcddtasimacilik.gov.tr/*"
      ],
      "js": [
        "stations.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audio/alert.wav",
        "icons/*"
      ],
      "matches": [
        "https://*.tcddtasimacilik.gov.tr/*"
      ]
    }
  ]
}
